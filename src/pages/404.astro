---
// 主题化 404：贴「逃生」题材，给岔路口多个明确的回程（N3）——
// 不只是「返回目录」，而是按常见意图给出口：回目录 / 六域地图 /
// 四张对照表 / 别名索引 / 关于本站（来源规则）。
// 注意：GitHub Pages 项目站点用 dist/404.html 兜底 404——本文件构建产物即
// dist/404.html，不需要额外配置。
import Base from '../layouts/Base.astro';

const B = import.meta.env.BASE_URL;
---

<Base title="走丢了" description="这一页不在逃生路线图里。">
  <div class="notfound">
    <p class="nf-emoji">🧭</p>
    <h1>你走丢了</h1>
    <p>这一页不在逃生路线图里。别在岔路口站着——选一个方向：</p>
    <div class="nf-exits">
      <a class="btn" href={B}>返回目录</a>
      <a class="btn" href={`${B}#domains`}>六域地图</a>
      <a class="btn" href={`${B}#tables`}>四张对照表</a>
      <a class="btn" href={`${B}aliases/`}>别名索引</a>
      <a class="btn" href={`${B}about/`}>关于本站 / 来源规则</a>
    </div>
  </div>
</Base>
