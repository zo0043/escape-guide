---
// 主题化 404：贴「逃生」题材，给岔路口一个明确的回程。
// 注意：GitHub Pages 项目站点用 dist/404.html 兜底 404——本文件构建产物即
// dist/404.html，不需要额外配置。验收脚本的产物页数断言 43→44 已同步更新。
import Base from '../layouts/Base.astro';

const B = import.meta.env.BASE_URL;
---

<Base title="走丢了" description="这一页不在逃生路线图里。">
  <div class="notfound">
    <p class="nf-emoji">🧭</p>
    <h1>你走丢了</h1>
    <p>这一页不在逃生路线图里。先回到目录，别在岔路口站着。</p>
    <a class="btn" href={B}>返回目录</a>
  </div>
</Base>
