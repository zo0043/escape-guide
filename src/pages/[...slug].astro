---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { computeBacklinksFrom, normalizeCollection } from '../lib/entries.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('escape');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

// 反链从集合数据算，**不读磁盘**：Astro 构建时本模块会被打包，
// 依赖 import.meta.url 的路径会失效，导致反链静默变 0。
const all = normalizeCollection(await getCollection('escape'));
const backlinksBySlug = computeBacklinksFrom(all);

const B = import.meta.env.BASE_URL;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const backlinks = backlinksBySlug.get(entry.id) ?? [];

// 五节名是闸门强制常量，id 由 rehype 插件（headings.mjs）按同一映射挂上
const TOC = [
  ['怎么做', 'howto'],
  ['说人话', 'plain'],
  ['收益', 'gain'],
  ['来源', 'source'],
  ['备注', 'notes'],
];

// 域页链接：域串形如「02 理念与理论」
const domainNum = d.chapter.split(' ')[0];
const domainName = d.chapter.split(' ').slice(1).join(' ');

// 一屏速览：优先用条目自带的 when/keyNumber/maxRisk；
// 新内容还没补齐这些字段时，回落到结构化事实（成本/收益/证据），不留空格子。
// 「一句话结论」不做成卡片——它作为标题下的 standfirst 常驻（entry-lede），避免重复。
const QUICK = [
  d.when
    ? { label: '什么时候用', value: d.when }
    : { label: '成本', value: `钱 ${d.cost.money} · 时间 ${d.cost.time} · 毅力 ${d.cost.will}` },
  d.keyNumber
    ? { label: '关键数字', value: d.keyNumber, num: true }
    : { label: '收益', value: `${d.gain}（口径：${d.metric}）` },
  d.maxRisk
    ? { label: '最大风险', value: d.maxRisk, risk: true }
    : { label: '证据等级', value: `${d.evidence} 级${d.disputed ? '（有争议）' : ''}`, num: true },
].filter((c) => c.value);
---

<Base title={d.title} description={d.description}>
  <article>
    <p class="entry-crumb">
      <a href={`${B}topic/${domainNum}/`}>{d.chapter}</a>
    </p>
    <header class="entry-header">
      <h1>{d.title}</h1>
      <p class="entry-lede">{d.lede ?? d.description}</p>
      <p class="entry-meta">
        {d.checked && <>来源核对于 {d.checked.toISOString().slice(0, 10)}</>}
        {d.disputed && <> · <b>本站标注：结论存在争议</b></>}
      </p>
    </header>

    <div class="quick-cards">
      {
        QUICK.map((c) => (
          <div class="quick-card">
            <span class="qc-label">{c.label}</span>
            <p class={`qc-value${c.num ? ' is-num' : ''}${c.risk ? ' is-risk' : ''}`}>{c.value}</p>
          </div>
        ))
      }
    </div>

    <nav class="section-chips" aria-label="页内目录">
      {TOC.map(([label, id]) => <a class="chip" href={`#${id}`}>{label}</a>)}
    </nav>

    <div class="entry-body">
      <Content />
    </div>
  </article>

  {
    backlinks.length > 0 && (
      <aside class="backlinks">
        <h2 class="backlinks-title">指向本条的条目（{backlinks.length}）</h2>
        <ul>
          {backlinks.map((b) => (
            <li>
              <a href={`${B}${b.slug}/`}>{b.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Base>
