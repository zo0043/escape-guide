---
// 对照表页（P1-C）：一张表代替十页长文。
// 数据全部来自 src/data/compare.json——每一行的数字都必须能在来源条目里
// 逐字 grep 到（verify-escape-guide.sh 有对应不变式，防表格与条目漂移）。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import tables from '../../data/compare.json';
import { makeEntryIndex } from '../../lib/entries.mjs';
import { normalizeKey, slugify } from '../../lib/slug.mjs';

export async function getStaticPaths() {
  return tables.tables.map((t) => ({ params: { table: t.slug }, props: { t } }));
}

const B = import.meta.env.BASE_URL;
const { t } = Astro.props;
const entries = await getCollection('escape');
// C6/S4：按标题**或别名**取条目。全库 50 个标题用半角冒号、50 个用全角冒号，
// compare.json 的 src 两种写法都出现过——只认 title 会把另一种静默丢成 undefined，
// 争议小标和来源链接一起消失，而页面照常渲染、不报错。
// P0-1（audit 03-T1）：索引键是 normalizeKey(title/alias)（trim+小写+去空白），
// 查表必须**同样归一化**——raw `get(r.src)` 对含空格/大写的 src（LTCM、
// 「麦哲伦 13 年的真相」「1992 的单日十亿」）静默失配，3 行首列失链 + 丢争议小标。
const byTitle = makeEntryIndex(entries);
const evClass = (ev: string) => `ev ev-${ev}`;

// U2/M6：disputed 构建期从内容集合自动带出（不手填进 compare.json）——
// 每行的来源条目标了争议，表内证据格渲染「争议」小标。
// 与 about.md:64 的规则同源：A/B 级条目存在反方证据时置 disputed: true。
const rowDisputed = (r: any) => {
  const entry = byTitle.get(normalizeKey(r.src));
  return entry ? Boolean(entry.data.disputed) : false;
};

// N5：表 → 所属域的映射（与 topic/[domain].astro 的 RELATED_TABLES 同源，
// 此处为反向：crashes→01、masters/philosophy→02、biases→03）。
const TABLE_DOMAIN: Record<string, string> = {
  crashes: '01',
  masters: '02',
  philosophy: '02',
  biases: '03',
  // 2026-10-15 审查项 4：triggers(触发索引)横跨多个域,不挂单域 chip,不加映射。
};
const domainNum = TABLE_DOMAIN[t.slug];
---

<Base title={`${t.title} · 对照表`} description={t.lede}>
  <section class="topic-head">
    <p class="entry-crumb">对照表 · {t.rows.length} 行 · 每行可回源到条目</p>
    <h1 class="hero-title">{t.title}</h1>
    <p class="topic-essence">{t.lede}</p>
  </section>

  <section class="section">
    <div class="table-scroll">
      <table class="compare">
        <thead>
          <tr>
            {t.cols.map((c: string) => <th>{c}</th>)}
            <th class="col-ev">证据</th>
          </tr>
        </thead>
        <tbody>
          {
            t.rows.map((r: any) => {
              const entry = byTitle.get(normalizeKey(r.src));
              // P1-12（02-P-13）：行级深链——id 用行首事件名 slugify（复用 lib/slug.mjs，
              // 与条目 URL 同一套规则）；行首 4 表 70 行实测无撞 id（t11 交付报告有记录）。
              const rowId = slugify(r.c[0]);
              // 2026-10-15 审查项 4：回链接列默认首列(既有 4 表行为零变化)；
              // triggers 表经 linkCol: 1 指定第二列(条目逐字标题)为回链目标。
              const linkCol: number = t.linkCol ?? 0;
              return (
                <tr id={rowId}>
                  {r.c.map((cell: string, i: number) =>
                    i === 0 ? (
                      <th scope="row" class="row-head" data-label={t.cols[0]}>
                        {linkCol === 0 && entry ? <a href={`${B}${entry.id}/`}>{cell}</a> : cell}
                        {/* 行内「#」锚：纯 CSS a::after content（零 JS），见 global.css .row-anchor */}
                        <a class="row-anchor" href={`#${rowId}`} aria-label={`「${cell}」行的锚点`}></a>
                      </th>
                    ) : (
                      <td data-label={t.cols[i]}>
                        {linkCol === i && entry ? <a href={`${B}${entry.id}/`}>{cell}</a> : cell}
                      </td>
                    )
                  )}
                  <td class={evClass(r.ev)} data-label="证据">
                    {r.ev}
                    {rowDisputed(r) && <span class="ev-flag">争议</span>}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    {t.foot && <p class="compare-foot">{t.foot}</p>}
  </section>

  <nav class="topic-nav" aria-label="对照表之间">
    {
      domainNum && (
        <a class="chip" href={`${B}topic/${domainNum}/`}>← 来自 {domainNum} 域</a>
      )
    }
    <a class="chip" href={`${B}#tables`}>全部对照表</a>
    {
      tables.tables.map((x) => (
        <a class="chip" href={`${B}compare/${x.slug}/`} aria-current={x.slug === t.slug ? 'page' : undefined}>
          {x.title}
        </a>
      ))
    }
  </nav>
</Base>
