---
// 首页 = 杂志式入口：Hero（承诺 + 数字墙 + 信任线）→ 三入口（按处境）→ 六域地图 → 折叠全目录 → 来源规则。
// 所有数字与清单都在构建期从集合算出，不硬编码。
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import tables from '../data/compare.json';
import { makeEntryIndex } from '../lib/entries.mjs';
import { normalizeKey } from '../lib/slug.mjs';
// P2-C3（U-4）：PATHS 提取为共享数据源——本页渲染路径卡，[...slug].astro 反查条目路径归属
// （进度 chip 行），两页同口径。唯一事实源约束（P0-3）与 PATH 04 无 map 回链的裁定
// 见 lib/paths.mjs 头注释。
import { MAP_TITLE, PATHS } from '../lib/paths.mjs';

const B = import.meta.env.BASE_URL;
const entries = await getCollection('escape');

// 域串形如「02 理念与理论」：编号 + 名称拆开渲染
const domains = [...new Set(entries.map((e) => e.data.chapter))].sort((a, b) => a.localeCompare(b, 'zh'));

const DOMAIN_ESSENCE = {
  '01': '市场怎么运转、钱从哪来、极端行情里到底发生过什么。',
  '02': '被验证过的原则、大师的赚钱逻辑，以及背后的数学。',
  '03': '你会怎么被骗：偏差、情绪、群体，以及能练的动作。',
  '04': '规则怎么保护你、被坑了找谁、红线在哪里。',
  '05': '不犯致命的错：钱的性质、仓位、不做清单。',
  '06': '动手查：公司、牌照、规则、数据从哪里来。',
};

const byDomain = domains.map((chapter) => {
  const [num, ...rest] = chapter.split(' ');
  const items = entries
    .filter((e) => e.data.chapter === chapter)
    .sort((a, b) => (a.data.weight ?? 0) - (b.data.weight ?? 0));
  return { num, name: rest.join(' '), chapter, items, essence: DOMAIN_ESSENCE[num] ?? '' };
});

// 按标题/别名取条目链接：标题或别名必须存在，否则构建期直接报错（不静默漏链）。
// t15 修 t10 遗留 #1：原来是 entries.find(title===) 的 title-only 查找——C6 之后
// 49 个全角冒号别名存在，但本页任何别名/全角写法都会被判「不存在」而 throw
// （与 t10 修掉的 compare 缺陷同源，只是失败方式更响；响≠对，仍是缺陷）。
// 改用 t10 的 makeEntryIndex（标题/别名 → 条目对象，索引本身冲突即抛错），
// 查表走 normalizeKey（大小写/空白不敏感；标点敏感是 t10 的有意设计，
// 冒号差异由别名覆盖而不是靠剥标点）。
// 双向保留：查不到仍显式 throw——把「太响」修掉，不许把缺陷改成「静默丢失」。
const entryIndex = makeEntryIndex(entries);
const byTitle = (title) => {
  const hit = entryIndex.get(normalizeKey(title));
  if (!hit) throw new Error(`首页路径引用了不存在的条目标题：${title}`);
  return `${B}${hit.id}/`;
};

// 四条处境路径数据（PATHS / MAP_TITLE）已提取至 ../lib/paths.mjs（P2-C3 共享源）。
// byTitle() 查不到标题构建即 throw（42-46 行），是引用不存在的条目的天然兜底。

const nA = entries.filter((e) => e.data.evidence === 'A').length;
const nDisputed = entries.filter((e) => e.data.disputed).length;
const nDomains = domains.length;
// 2026-10-15 审查项 5（D3）：stat「122 条可执行条目」过度承诺 → 「122 条 · 42 条可直接照做」。
// 42 的机检口径 = frontmatter layer 计数：执行 37 + 工具 7（理念 43 / 档案 37 不可直接照做，
// 两种用途用措辞分开）；layer 四值定义与 content.config.ts 一致，随集合构建期重算不硬编码。
const nDirect = entries.filter((e) => {
  const L = (e.data as any).layer;
  return L === '执行' || L === '工具';
}).length;
---

<Base anchors>
  <section class="hero">
    <p class="hero-kicker">A 股散户逃生指南</p>
    <h1 class="hero-title">先别亏钱，<br />再谈赚钱。</h1>
    <p class="hero-lede">
      这里没有荐股、没有预测、没有「稳赚」。有的是把「别亏钱」拆成一条条<b>能照着做</b>的清单：
      每条写清<b>什么时候用</b>、<b>怎么做</b>、<b>做完得到什么</b>、<b>怎么算过关</b>，
      并标注成本、收益口径与证据等级。
    </p>
    <div class="hero-cta">
      <a class="cta cta-primary" href="#start">从哪开始 →</a>
      <a class="cta" href="#domains">六域地图</a>
      <a class="cta" href={`${B}about/#来源规则`}>来源规则（完整版）</a>
    </div>

    <div class="stat-wall">
      <div>
        <span class="stat-num">{entries.length}</span>
        <span class="stat-label">条 · {nDirect} 条可直接照做</span>
      </div>
      <div>
        <span class="stat-num">{nDomains}</span>
        <span class="stat-label">个认知域</span>
      </div>
      <div>
        <a class="stat-link" href={`${B}aliases/#evidence-a`}>
          <span class="stat-num">{nA}</span>
          <span class="stat-label">条 A 级一手证据</span>
        </a>
      </div>
      <div>
        <span class="stat-num">{nDisputed}</span>
        <span class="stat-label">条如实标注争议</span>
      </div>
    </div>

    <p class="trust-line">
      本站的来源规则只有一条：<b>打不开的链接等于没有来源</b>。每条都标 A/B/C 证据等级与核对日期；核得到但没逐条核的写「需人工核对」，口径本身不存在的写「无公开统计」，各家定义不一的写「无单一官方口径」——三种「算不出」不是同一种没有。宁可少写一条，不编一个数字。本站不是不亏保证：逃生上限是亏损不毁生活，用保命钱入市者，本站任何方法都救不了你。
    </p>
  </section>

  <!-- 2026-10-15 审查项 1：地图升格总纲——hero 与 START HERE 之间加「逃生总纲」卡，
       整卡锚向地图条目（byTitle 校验，查不到构建即 throw）。措辞 = 审查项 1「为什么」
       + 地图条目 lede 原文。地图条目不动 chapter（审查裁定：升格胜于搬家）。 -->
  <section class="section" id="outline">
    <p class="section-label">ESCAPE OUTLINE</p>
    <h2 class="section-title">逃生总纲</h2>
    <a class="start-card outline-card" href={byTitle(MAP_TITLE)}>
      <span class="sc-num">先定位，再动作</span>
      <span class="sc-title">投资体系地图：六个环节与你的入口</span>
      <span class="sc-desc">
        逃生是过程，不是语料。入口选错、先补理论后止血，是最贵的顺序倒错。它不教动作，只回答「先做什么、后做什么、怎么知道过没过关」。
      </span>
      <span class="sc-path">
        <b>内容</b>：六环节总表（每环有可当场做出来的过关标准）· 三个入口的步骤路径（入口 A 六步、入口 B 与 C 各五步）· 一个「已被套」者的完整走查（假设案例）
      </span>
    </a>
  </section>

  <section class="section" id="start">
    <p class="section-label">START HERE</p>
    <h2 class="section-title">你现在是什么处境？</h2>
    <p class="section-intro">你现在在逃生路线的哪一段？顺序即优先级。</p>
    <div class="start-here">
      {
        PATHS.map((p) => (
          <div class="start-card">
            <span class="sc-num">{p.num}</span>
            <a class="sc-title" href={byTitle(p.steps[0])}>{p.title}</a>
            <span class="sc-desc">{p.desc}</span>
            <span class="sc-path">
              <b>路径</b>：{p.steps.map((s, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={byTitle(s)}>{s.split('：')[0]}</a>
                </>
              ))}
              {
                p.map && (
                  <>
                    {' · '}
                    <a href={byTitle(p.map)}>完整步骤见{p.map.split('：')[0]}</a>
                  </>
                )
              }
            </span>
            {
              // handover P0-6「只读一句」桥：长文步骤（PATH 01 第 2 步 / PATH 03 第 1 步）
              // 在路径卡上先给一句核心结论（数据在 lib/paths.mjs 的 bridge，条目页已有速览卡）。
              Object.entries(p.bridge ?? {}).map(([idx, text]) => (
                <span class="sc-bridge">
                  <b>长文只读一句</b>：第 {idx} 步
                  <a href={byTitle(p.steps[Number(idx) - 1])}>《{p.steps[Number(idx) - 1].split('：')[0]}》</a>
                  ——{text}
                </span>
              ))
            }
            {
              // 2026-10-15 审查项 1/3：每条路径卡一行「终点」——四路径每条有可达终点，
              // 无「路径走完」死端（PATH 01-03 终点 = 季度重走定位表 → 地图；
              // PATH 04 = 重建起点实链 → 先分清三种钱）。
              p.end && (
                <span class="sc-end">
                  <b>终点</b>：<a href={byTitle(p.end.target)}>{p.end.label}</a>
                </span>
              )
            }
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="domains">
    <p class="section-label">SIX DOMAINS</p>
    <h2 class="section-title">六域地图</h2>
    <p class="section-intro">
      一个完整的投资体系要回答六件事：市场怎么运转、理念对不对、人性怎么骗你、规则怎么保护你、
      怎么不犯致命的错、以及怎么自己动手查证。
      六域是内容地图、六环节是学习顺序——同一批条目的两种划分；按顺序走的那条路见
      <a href={byTitle(MAP_TITLE)}>投资体系地图</a>。
    </p>
    <div class="domain-map">
      {
        byDomain.map((d) => (
          <a class="domain-card" href={`${B}topic/${d.num}/`}>
            <span class="dc-num">{d.num}</span>
            <h3 class="dc-name">{d.name}</h3>
            <p class="dc-essence">{d.essence}</p>
            <!-- 2026-10-15 审查项 6：编号是坐标不是顺序（各域页头部同句） -->
            <p class="dc-essence">编号是地图坐标，不是学习顺序，顺序见路径与总纲</p>
            <p class="dc-meta">
              {d.items.length} 条 · 其中 A 级证据 {d.items.filter((e) => e.data.evidence === 'A').length} 条
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" id="tables">
    <p class="section-label">COMPARE</p>
    <h2 class="section-title">对照表</h2>
    <p class="section-intro">
      五张表代替四十页长文：股灾数字、大师业绩、认知偏差自查、理念对错、冲动触发。每一行都能点回条目，表里的数字与条目逐字一致。
    </p>
    <div class="domain-map">
      {
        tables.tables.map((t) => (
          <a class="domain-card" href={`${B}compare/${t.slug}/`}>
            <h3 class="dc-name">{t.title}</h3>
            <p class="dc-essence">{t.lede}</p>
            <p class="dc-meta">{t.rows.length} 行 · 每行可回源</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" id="all">
    <p class="section-label">ALL ENTRIES</p>
    <h2 class="section-title">全部条目（{entries.length}）</h2>
    <p class="section-intro">
      按域分组，默认展开（点域名可收起）。每条下面一句话说明它解决什么问题，并标出它的证据等级——A/B/C 的定义见下方「本站的来源规则」（以关于本站为权威）。
      想按俗称/别名查，走<a href={`${B}aliases/`}>别名索引</a>。
    </p>
    <!-- P2-C2（U-7）：默认全开 + 深链锚点（零 JS，纯 HTML 锚点）——
         summary 带 id={域名}：#域名 形状与域页 h1 命名一致（如 /escape-guide/#规则与制度）；
         每个 dir-item 带 id={条目 slug}：与 content.config.ts generateId（lib/slug.mjs slugify）同口径，122 条零撞，
         支持 /escape-guide/#条目slug 从站内链接直达单条。 -->
    <div class="directory">
      {
        byDomain.map((d) => (
          <details class="dom-details" open>
            <summary class="dom-summary" id={d.name}>
              <span class="dom-summary-num">{d.num}</span>
              <span class="dom-summary-name">{d.name}</span>
              <span class="dom-summary-count">{d.items.length} 条</span>
              <span class="dom-summary-essence">{d.essence}</span>
            </summary>
            <ul class="dir-list">
              {d.items.map((e) => (
                <li class="dir-item" id={e.id}>
                  <a class="dir-link" href={`${B}${e.id}/`}>
                    <span class={`dir-ev ev-${e.data.evidence}`}>{e.data.evidence}</span>
                    {e.data.title}
                    {(e.data as any).layer && (
                      <span class={`layer-tag layer-${(e.data as any).layer}`}>{(e.data as any).layer}</span>
                    )}
                  </a>
                  {e.data.description && <p class="dir-kicker">{e.data.description}</p>}
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section" id="rules">
    <p class="section-label">EVIDENCE RULES</p>
    <h2 class="section-title">本站的来源规则</h2>
    <p class="section-intro">
      每条条目的「来源」节都必须交代证据等级。这不是免责声明，是让读者知道这个数字能信到什么程度。
      等级取「正文主张的主要依据」，背景来源允许低一级并在来源节逐条标级，含低一级来源时不降级；C 级另分三个子档（C1 史料不可核 / C2 民间共识无出处 / C3 二手通说待核），在「来源」节标注。
    </p>
    <div class="entry-body">
      <ul>
        <li><b>A 级</b>：有一手数字：官方统计（上交所统计年鉴、证监会、中国结算）或同行评议研究，正文必须给出具体数字；推导型/定义性事实见「来源规则」（数字由推导确定）。</li>
        <li><b>B 级</b>：有监管原文或已生效的规则、判决，或同行评议文献/书目引用（只引定性结论、不引具体统计数），事实确定但无法量化。</li>
        <li><b>C 级</b>：经验或行业共识，没有可直接引用的出处。</li>
        <li><b>争议标记</b>：研究结论相互冲突、或数据口径存在重大分歧的条目会显式标注。</li>
      </ul>
      <p>完整的格式规范、来源要求与免责说明见 <a href={`${B}about/`}>关于本站</a>。</p>
    </div>
  </section>
</Base>
