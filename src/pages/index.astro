---
// 首页即目录：hero（站名 + 定位 + 数据徽章）→ 章节导航（sticky）→ 8 章卡片网格。
// 徽章数字全部构建期从集合算出，不硬编码（内容加减条目，首页自动跟上）。
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryTags from '../components/EntryTags.astro';

const B = import.meta.env.BASE_URL;

const entries = await getCollection('escape');

const chapters = [...new Set(entries.map((e) => e.data.chapter))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);

const byChapter = chapters.map((chapter) => {
  // 章节串形如「02 A股祖训」：编号 + 名称拆开渲染
  const [num, ...rest] = chapter.split(' ');
  return {
    num,
    name: rest.join(' '),
    chapter,
    items: entries
      .filter((e) => e.data.chapter === chapter)
      .sort((a, b) => (a.data.weight ?? 0) - (b.data.weight ?? 0)),
  };
});

const nA = entries.filter((e) => e.data.evidence === 'A').length;
const nLoss = entries.filter((e) => e.data.metric === '亏损').length;
const metrics = [...new Set(entries.map((e) => e.data.metric))].sort();
const evidence = [...new Set(entries.map((e) => e.data.evidence))].sort();
---

<Base>
  <div class="hero">
    <h1>A股散户逃生指南</h1>
    <p class="hero-sub">
      把「别亏钱」拆成一条条能照着做的清单。每条写清<b>什么时候用</b>、<b
        >怎么做</b
      >、<b>做完得到什么</b>、<b>怎么算过关</b>，并标注成本、收益口径与证据等级。
      没有一手出处的条目会如实写明——<b>打不开的链接等于没有来源</b>。
    </p>
    <div class="hero-badges">
      <span class="badge"><b>{entries.length}</b> 条</span>
      <span class="badge"><b>{chapters.length}</b> 章</span>
      <span class="badge"><b>{nA}</b> 条 A 级证据</span>
      <span class="badge"><b>{nLoss}</b> 条亏损口径</span>
    </div>
  </div>

  <nav class="chapter-nav" aria-label="章节导航">
    <div class="wrap-index">
      {byChapter.map(({ num, name, chapter }) => (
        <a href={`#ch-${num}`}>{num} {name}</a>
      ))}
    </div>
  </nav>

  {
    byChapter.map(({ num, name, chapter, items }) => (
      <section class="guide-chapter" id={`ch-${num}`}>
        <header class="guide-chapter-head">
          <span class="chapter-num">{num}</span>
          <h2 class="guide-chapter-title">{name}</h2>
          <span class="chapter-count num">{items.length} 条</span>
        </header>
        <div class="guide-grid">
          {items.map((e) => (
            <article class="guide-card">
              <a class="guide-link" href={`${B}${e.id}/`}>
                {e.data.title}
              </a>
              {e.data.description && <p class="guide-desc">{e.data.description}</p>}
              <EntryTags
                cost={e.data.cost}
                gain={e.data.gain}
                metric={e.data.metric}
                evidence={e.data.evidence}
                disputed={e.data.disputed}
              />
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <p class="hero-sub" style="margin-top:2.5rem;font-size:0.85rem">
    统计：{entries.length} 条 · 口径 {metrics.join(' / ')} · 证据等级 {evidence.join(' / ')} ·
    <a href={`${B}about/`}>格式与来源规则</a>
  </p>
</Base>
