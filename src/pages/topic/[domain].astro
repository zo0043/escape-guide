---
// 域页（主题页）：章 → 条之间的中间层。
// 对标 Our World in Data 的 topic page：先给这个域在解决什么问题，再给条目清单（带一句话要点）。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import tables from '../../data/compare.json';

export async function getStaticPaths() {
  const entries = await getCollection('escape');
  const domains = [...new Set(entries.map((e) => e.data.chapter))].sort((a, b) => a.localeCompare(b, 'zh'));
  return domains.map((chapter) => {
    const num = chapter.split(' ')[0];
    return { params: { domain: num }, props: { chapter } };
  });
}

const B = import.meta.env.BASE_URL;
const entries = await getCollection('escape');

const ESSENCE = {
  // 2026-10-15 审查项 5：01 域 ESSENCE 降格「证据层」——原句市场优先 + 预测味
  // （「看不懂这一域，后面所有的技巧都只是赌运气」与总纲双重矛盾）。
  // 措辞 = 审查原文（引号按站内「」体例）。
  '01': '本域是证据层：逃生不靠预测，靠「发生过什么」的可核记录——读它不是学预测，是给止血与设限拿底气。',
  '02': '这一域回答：哪些做法被长期验证过、哪些只是听起来有道理。原则背后都有数学或数据，条目尽量把它挖出来。',
  '03': '这一域回答：你为什么会做错。偏差不是「不够聪明」，而是人脑的默认设置——认识它、给它设防，比发誓「我要理性」有用得多。',
  '04': '这一域回答：规则怎么保护你、被坑了找谁、红线在哪里。散户最大的劣势是信息，最大的优势是规则对所有人一样。',
  '05': '这一域回答：怎么不犯致命的错。亏 50% 要赚 100% 才回本——防守不是保守，是算术。',
  '06': '这一域回答：怎么自己查证。别人给的结论会过期、会骗人，会自己查的人不用信任何人。',
};

const CHECK = {
  // 2026-10-15 审查项 5：01 域自检句带预测味（「我知道当前市场处在什么位置吗」）
  // → 按审查原文换（对齐地图环节二过关标准「能报出两次以上崩盘的共同结构」）。
  '01': ['我能说清自己买的东西靠什么赚钱吗？', '我能报出两次崩盘的共同结构吗？'],
  '02': ['我用的方法是被长期验证的，还是最近听说很灵的？', '我能说出这个方法的失效条件吗？'],
  '03': ['最近三次亏损，是判断错还是情绪驱动的操作？', '我有没有在亏损时加过仓？'],
  '04': ['我知道被上市公司坑了该走哪条官方路径吗？', '我知道自己账户里每项费用的规则吗？'],
  '05': ['我的仓位大小是算出来的，还是「感觉差不多」？', '我有没有一笔「亏了会影响生活」的钱在市场里？'],
  '06': ['我上一次查规则是自己去官网查的，还是看别人转述的？', '我知道自己持仓公司的退市风险指标要去哪查吗？'],
};

const { chapter } = Astro.props;
const num = chapter.split(' ')[0];
const name = chapter.split(' ').slice(1).join(' ');
const items = entries
  .filter((e) => e.data.chapter === chapter)
  .sort((a, b) => (a.data.weight ?? 0) - (b.data.weight ?? 0));

// P1-13（02-P-14/U-3）：本域条目按 layer 分 4 段（理念→执行→档案→工具）+ 层直达 chip。
// 段内保持 weight 序；单域只落一层时不渲染段头/直达（无信息量，列表同形于改前）。
// 前置：t6 已修马克斯 pair 的 layer 矛盾（档案→理念），四色不会把数据层矛盾固化进 UI。
const LAYERS = ['理念', '执行', '档案', '工具'];
const layerGroups = LAYERS.map((L) => ({
  layer: L,
  items: items.filter((e) => (e.data as any).layer === L),
})).filter((g) => g.items.length > 0);

// P2-C9(a)（01-C-01）：单层域注明——本域条目 layer 全同时，在列表前给一句层级信号，
// 措辞与 content.config.ts 的 layer 四值定义（S1）逐字一致；多层域已由上面 P1-13 的
// 四段 + 层直达 chip 表达（条件互斥：length===1 才渲染注明，length>1 才渲染 chip/段头）。
const LAYER_GLOSS: Record<string, string> = {
  理念: '讲清「为什么会这样」的概念/机制/理论',
  执行: '可以直接照做的动作、纪律、流程、自查',
  档案: '按人或按事件立档，核心是「发生过什么 + 可核数字」',
  工具: '去哪里查、怎么查的入口（查* 类）',
};

// 2026-10-15 审查项 5：档案层声明——档案（37 条）是引用库，不是阅读顺序。
// layer 机检：只有 01（18 条）/ 02（19 条）两域有档案层，按 layer 键注即只落这两页
// （与审查「01/02 域页档案段各加一句」同一范围）；单层域不走此处（单层域无档案层）。
const LAYER_NOTE: Record<string, string> = {
  档案: '此层是引用库，不是阅读顺序',
};

// 每个域指向与它相关的对照表（P1-C 导航层）
const RELATED_TABLES: Record<string, string[]> = {
  '01': ['crashes'],
  '02': ['masters', 'philosophy'],
  '03': ['biases'],
};
const related = RELATED_TABLES[num] ?? [];

const domains = [...new Set(entries.map((e) => e.data.chapter))].sort((a, b) => a.localeCompare(b, 'zh'));
const nA = items.filter((e) => e.data.evidence === 'A').length;
---

<Base title={`${name} · 域`} description={ESSENCE[num]}>
  <section class="topic-head">
    <p class="entry-crumb">第 {num} 域 · {items.length} 条 · A 级证据 {nA} 条</p>
    <h1 class="hero-title">{name}</h1>
    <p class="topic-essence">{ESSENCE[num]}</p>
    <!-- 2026-10-15 审查项 6：域编号声明（与首页 6 张域卡同句；重编号为 URL 单向门，已否决） -->
    <p class="topic-coord">编号是地图坐标，不是学习顺序，顺序见路径与总纲</p>
  </section>

  <section class="section">
    <p class="section-label">ENTRIES</p>
    <h2 class="section-title">本域条目</h2>
    {layerGroups.length === 1 && (
      <p class="entry-crumb">
        本域 {items.length} 条均为<span class={`layer-tag layer-${layerGroups[0].layer}`}>{layerGroups[0].layer}</span>层——{LAYER_GLOSS[layerGroups[0].layer]}
      </p>
    )}
    {layerGroups.length > 1 && (
      <nav class="topic-nav layer-jump" aria-label="层直达">
        <span class="chip chip-static">层</span>
        {layerGroups.map((g) => (
          <a class={`chip layer-${g.layer}`} href={`#layer-${g.layer}`}>
            {g.layer} {g.items.length}
          </a>
        ))}
      </nav>
    )}
    {layerGroups.map((g) => (
      <>
        {layerGroups.length > 1 && (
          <h3 class={`topic-layer-head layer-${g.layer}`} id={`layer-${g.layer}`}>
            {g.layer} · {g.items.length} 条
          </h3>
        )}
        {layerGroups.length > 1 && LAYER_NOTE[g.layer] && (
          <p class="topic-layer-note">{LAYER_NOTE[g.layer]}</p>
        )}
        <ul class="topic-list">
          {g.items.map((e) => (
            <li>
              <a class="topic-item-title" href={`${B}${e.id}/`}>
                {e.data.title}
              </a>
              {e.data.description && <p class="topic-item-kicker">{e.data.description}</p>}
              <p class="topic-item-meta">
                收益档位 {e.data.gain} · 量纲 {e.data.metric} · 证据 {e.data.evidence}
                {e.data.disputed ? ' · 有争议' : ''}
                {(e.data as any).layer ? (
                  <>
                    {' · '}
                    <span class={`layer-tag layer-${(e.data as any).layer}`}>{(e.data as any).layer}</span>
                  </>
                ) : null}
              </p>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section class="section">
    <p class="section-label">SELF CHECK</p>
    <h2 class="section-title">读完之后，问自己两个问题</h2>
    <div class="entry-body">
      <ul>
        {CHECK[num].map((q) => <li>{q}</li>)}
      </ul>
      <p>两个都答不上来，说明这一域还需要再读一遍——不是背条目，是能用自己的话回答。</p>
    </div>
  </section>

  {
    related.length > 0 && (
      <nav class="topic-nav" aria-label="相关对照表">
        <span class="chip chip-static">对照表 →</span>
        {related.map((slug) => {
          const t = tables.tables.find((x) => x.slug === slug);
          return t ? (
            <a class="chip" href={`${B}compare/${t.slug}/`}>{t.title}</a>
          ) : null;
        })}
      </nav>
    )
  }

  <nav class="topic-nav" aria-label="域间导航">
    <a class="chip" href={`${B}#domains`}>← 六域地图</a>
    {
      domains.map((c) => {
        const n = c.split(' ')[0];
        return (
          <a class="chip" href={`${B}topic/${n}/`} aria-current={n === num ? 'page' : undefined}>
            {c}
          </a>
        );
      })
    }
  </nav>
</Base>
